# Public URL, no trailing slash needed
BASE_URL=https://webmention.io

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=webmention
DB_USER=webmention
DB_PASS=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0

# Avatar archiving. Leave CA3DB_API_ENDPOINT empty to keep original photo URLs.
CA3DB_API_ENDPOINT=
CA3DB_API_KEY=
CA3DB_KEY_ID=
CA3DB_SECRET_KEY=
CA3DB_REGION=
CA3DB_BUCKET=
CA3DB_S3_URL=
# Public prefix written in place of CA3DB_S3_URL in stored avatar URLs.
# Defaults to BASE_URL/avatar. A deployment on another hostname that shares
# the production database should set this to the production value, e.g.
# https://webmention.io/avatar, so its rows match everyone else's.
CA3DB_AVATAR_URL=

# Outgoing requests refuse private and loopback addresses. Set to 1 only for local development.
ALLOW_PRIVATE_NETWORK=0

# Set to 1 when behind a proxy that sets X-Forwarded-Proto / X-Forwarded-For
TRUST_PROXY=0

# Where the web app writes its log (the worker logs to stderr)
LOG_FILE=

# Show exception details on error pages. Never in production.
APP_DEBUG=0
