{
    "name": "aaronpk/webmention.io",
    "description": "A hosted Webmention receiver",
    "type": "project",
    "license": "BSD-3-Clause",
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-pdo": "*",
        "ext-redis": "*",
        "ext-xmlwriter": "*",
        "indieauth/client": "^1.1",
        "p3k/xray": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Webmention\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Webmention\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
